# Vercel environment variables — set these in Vercel dashboard: Settings > Environment Variables

# Anthropic API key for the AI chat agent
ANTHROPIC_API_KEY=sk-ant-api03-...

# Space-Track.org credentials for satellite catalog (register free at https://www.space-track.org/auth/createAccount)
SPACE_TRACK_USER=your@email.com
SPACE_TRACK_PASS=yourpassword

# CloudFront distribution URL for satellite TLE catalog (add after AWS deploy in Session 18)
# Leave unset for local dev — falls back to /api/catalog Vercel function
VITE_CATALOG_URL=
