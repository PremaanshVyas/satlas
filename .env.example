# Vercel environment variables — set these in Vercel dashboard: Settings > Environment Variables

# Anthropic API key for the AI chat agent
ANTHROPIC_API_KEY=sk-ant-api03-...

# NOTE: Vercel does NOT hold Space-Track credentials. The ONLY client allowed to query
# Space-Track is the ECS orbital worker (creds live in AWS Secrets Manager as
# SPACETRACK_USER / SPACETRACK_PASS — see apps/orbital/.env.example). It writes
# catalog.tle + satcat.json to S3/CloudFront once per hour. Everything on Vercel
# (api/catalog.ts and the frontend) reads from CloudFront, never from Space-Track.

# CloudFront origin the api/catalog.ts proxy serves from. Defaults to the known
# distribution if unset.
CLOUDFRONT_CATALOG=https://dgsll6twimcwl.cloudfront.net/catalog.tle

# Point the frontend straight at CloudFront to skip the Vercel proxy entirely.
# Recommended in production. Leave unset for local dev (falls back to /api/tles).
VITE_CATALOG_URL=https://dgsll6twimcwl.cloudfront.net/catalog.tle

# Set to 1 to take the whole site to a maintenance screen (e.g. while the catalog
# has no valid data to serve). Leave unset/0 for normal operation.
VITE_MAINTENANCE=
