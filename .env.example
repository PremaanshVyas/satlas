# Vercel Edge Function — set these in Vercel dashboard: Settings > Environment Variables
ANTHROPIC_API_KEY=sk-ant-api03-...
ORBITAL_SERVICE_URL=https://your-service.up.railway.app

# Vite build-time variable — baked into the frontend bundle at build time.
# Must be set in Vercel dashboard BEFORE deploying. Without it, the frontend
# falls back to http://localhost:8000 and the satellite catalog won't load in production.
VITE_ORBITAL_SERVICE_URL=https://your-service.up.railway.app

# CloudFront distribution URL for satellite TLE catalog (set in Vercel env vars for production)
# Leave blank for local dev (falls back to /api/catalog Vercel function)
VITE_CATALOG_URL=
